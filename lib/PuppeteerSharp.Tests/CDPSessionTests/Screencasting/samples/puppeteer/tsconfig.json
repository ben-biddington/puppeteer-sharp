{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "test/*": ["test/*"]
    },
    "target": "ES2020",
    "skipLibCheck": true,
    "lib": ["esnext"],
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "moduleResolution": "node",
    "module": "commonjs",
    "outDir": "dist",
    "noEmit": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules"],
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  }
}
